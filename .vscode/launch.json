{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Commander Wars: C++ with QML debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--noUi",
                "--noAudio",
                "--spawnAiProcess", "0",
                "--aiSlave"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "visualizerFile": "${command:qt-cpp.natvis}",
            "showDisplayString": true
        },
        {
            "name": "Commander Wars: Android armv7 attach",
            "type": "lldb",
            "request": "launch",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build_android/libCommander_Wars_armeabi-v7a.so"
            ],
            "initCommands": [
                "settings set target.require-hardware-breakpoint true"
            ],
            "processCreateCommands": [
                "gdb-remote 5039"
            ],
            "preLaunchTask": "Commander Wars: Android debug server",
            "postDebugTask": "Commander Wars: Android debug cleanup"
        }
    ]
}