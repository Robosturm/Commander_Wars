<?xml version="1.0"?>
<ui>
    <Panel>
        <x>10</x>
        <y>10</y>
        <width>settings.getStageWidth() - 20</width>
        <height>settings.getStageHeight() - 80</height>
        <childs>
            <Label>
                <x>40</x>
                <y>settings.getStageHeight() / 2 - 180</y>
                <width>parentWidth - 80</width>
                <text>QT_TRANSLATE_NOOP("GAME","Reset Password")</text>
                <font>"main"</font>
                <hAlign>"Middle"</hAlign>
                <fontSize>48</fontSize>
            </Label>
            <Label>
                <x>settings.getStageWidth() / 2 - 310</x>
                <y>settings.getStageHeight() / 2 - 100</y>
                <width>220</width>
                <text>QT_TRANSLATE_NOOP("GAME","Username:")</text>
                <font>"main"</font>
                <fontSize>24</fontSize>
            </Label>
            <Label>
                <x>lastX + lastWidth + 10</x>
                <y>lastY</y>
                <width>220</width>
                <text>settings.getUsername()</text>
                <font>"main"</font>
                <fontSize>24</fontSize>
            </Label>
            <Label>
                <x>settings.getStageWidth() / 2 - 310</x>
                <y>lastY + lastHeight + 20</y>
                <width>220</width>
                <text>QT_TRANSLATE_NOOP("GAME","E-Mail:")</text>
                <font>"main"</font>
                <fontSize>24</fontSize>
            </Label>
            <Textbox>
                <Id>EmailBox</Id>
                <x>lastX + lastWidth + 10</x>
                <y>lastY</y>
                <width>400</width>
                <tooltip>QT_TRANSLATE_NOOP("GAME","E-Mail address for your account.")</tooltip>
                <startValue>""</startValue>
                <onEvent>ForgotPasswordDialog.emailAdress(input);</onEvent>
            </Textbox>
            <Label>
                <Id>CodeLabel</Id>
                <x>settings.getStageWidth() / 2 - 310</x>
                <y>lastY + lastHeight + 20</y>
                <width>220</width>
                <text>QT_TRANSLATE_NOOP("GAME","2FA Code:")</text>
                <font>"main"</font>
                <fontSize>24</fontSize>
                <visible>ForgotPasswordDialog.showCodeInput()</visible>
            </Label>
            <Textbox>
                <Id>CodeBox</Id>
                <x>lastX + lastWidth + 10</x>
                <y>lastY</y>
                <width>150</width>
                <tooltip>QT_TRANSLATE_NOOP("GAME","The current 6 digit code shown by your authenticator app.")</tooltip>
                <startValue>""</startValue>
                <visible>ForgotPasswordDialog.showCodeInput()</visible>
                <onEvent>ForgotPasswordDialog.codeInput(input);</onEvent>
            </Textbox>
            <Button>
                <Id>AbortButton</Id>
                <x>settings.getStageWidth() / 2 - 160</x>
                <y>lastY + lastHeight + 20</y>
                <width>150</width>
                <text>QT_TRANSLATE_NOOP("GAME","Abort")</text>
                <tooltip>QT_TRANSLATE_NOOP("GAME","Aborts the password reset.")</tooltip>
                <onEvent>ForgotPasswordDialog.abort();</onEvent>
            </Button>
            <Button>
                <Id>ResetButton</Id>
                <x>settings.getStageWidth() / 2 + 10</x>
                <y>lastY</y>
                <width>150</width>
                <text>QT_TRANSLATE_NOOP("GAME","Reset password")</text>
                <tooltip>QT_TRANSLATE_NOOP("GAME","Requests a password reset for your account.")</tooltip>
                <onEvent>ForgotPasswordDialog.resetPassword()</onEvent>
            </Button>
            <Button>
                <Id>SubmitCodeButton</Id>
                <x>settings.getStageWidth() / 2 + 10</x>
                <y>lastY</y>
                <width>150</width>
                <text>QT_TRANSLATE_NOOP("GAME","Submit code")</text>
                <tooltip>QT_TRANSLATE_NOOP("GAME","Sends the 2 factor authentication code to the server.")</tooltip>
                <visible>ForgotPasswordDialog.showCodeInput()</visible>
                <onEvent>ForgotPasswordDialog.submitCode()</onEvent>
            </Button>
        </childs>
    </Panel>
</ui>
